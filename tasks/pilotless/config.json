{
  "capability_profile": "planetary_6g_advanced",
  "workspace": {
    "container": {
      "docker_image": "agent_pilotless",
      "dockerfile_path": "docker/dockerfile_agent_container"
    }
  },
  "tools_config": {
    "sionna_doc_config": {
      "embedding_model": "<set-embedding-model>",
      "embedding_base_url": "<set-embedding-base-url>",
      "reranker_model": "<set-reranker-model>",
      "reranker_base_url": "<set-reranker-base-url>",
      "planetary_6g_config": {
        "enabled": true
      },
      "summarize_llm": {
        "model": "gpt-5.5",
        "base_url": "<set-summarize-llm-base-url>"
      }
    }
  },
  "higher_is_better": false,
  "prompt_path": "prompt.md",
  "agent_llm": {
    "model": "gpt-5.5",
    "base_url": "<set-agent-llm-base-url>"
  },
  "manager_llm": {
    "model": "gpt-5.5",
    "base_url": "<set-manager-llm-base-url>"
  }
}